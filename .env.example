# =============================================================================
# swipe-jobs — environment variables (M0: connection wiring only)
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Create separate Supabase projects + Sentry envs for staging and production.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (format: sb_publishable_...). Safe to expose to the browser —
# it is RLS-limited (cannot bypass Row Level Security). This is the forward-looking
# replacement for the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (format: sb_secret_...). SERVER ONLY. Bypasses RLS entirely.
# NEVER prefix this with NEXT_PUBLIC_. NEVER import it into client code.
# Not used yet in M0 — present so the wiring convention is documented.
SUPABASE_SECRET_KEY=

# ---- App -------------------------------------------------------------------
# Canonical site origin (no trailing slash). Used to build email verification
# links and auth redirect URLs. e.g. http://localhost:3000 (dev) or https://...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Resend (transactional email) ------------------------------------------
# Server-only API key (starts with re_). Sends the verification email (M1).
RESEND_API_KEY=
# Verified sender address, e.g. "SwipeJobs <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL=

# ---- Sentry ----------------------------------------------------------------
# DSN is public and safe to expose. When empty, Sentry stays disabled.
NEXT_PUBLIC_SENTRY_DSN=

# Used only for source-map upload at build time (CI / Vercel). Keep out of git.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
